generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────
// Enums
// ─────────────────────────────

enum Sex {
  MALE
  FEMALE
}

enum EncounterType {
  OUTPATIENT
  EMERGENCY
  INPATIENT
}

enum EncounterStatus {
  WAITING
  WITH_NURSE
  WITH_DOCTOR
  COMPLETED
  LEFT // left without being seen
  CANCELLED // removed — added by mistake
}

// Order matters: Postgres sorts enums in this order, so EMERGENCY comes first
enum Priority {
  EMERGENCY
  URGENT
  NORMAL
}

enum VisitType {
  NEW
  FOLLOW_UP
  REVIEW
  ANTENATAL
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────
// Roles & permissions (RBAC)
// ─────────────────────────────

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────
// Staff
// ─────────────────────────────

model User {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  email          String    @unique
  phone          String?
  passwordHash   String
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  consultingRoom String? // e.g. "Room 3" (doctors)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  registeredPatients  Patient[]        @relation("PatientRegisteredBy")
  doctorEncounters    Encounter[]      @relation("EncounterDoctor")
  createdEncounters   Encounter[]      @relation("EncounterCreatedBy")
  doctorAppointments  Appointment[]    @relation("AppointmentDoctor")
  createdAppointments Appointment[]    @relation("AppointmentCreatedBy")
  schedules           DoctorSchedule[]
  leaves           DoctorLeave[]
  recordedVitals           Vitals[] @relation("VitalsRecordedBy")
  auditLogs           AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([departmentId])
}

// ─────────────────────────────
// Departments & doctor schedules
// ─────────────────────────────

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  doctors      User[]
  appointments Appointment[]
  encounters   Encounter[]

  createdAt DateTime @default(now())
}

model DoctorSchedule {
  id        String @id @default(cuid())
  doctorId  String
  doctor    User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String // "09:00" (Lagos time)
  endTime   String // "17:00" (Lagos time)

  @@unique([doctorId, dayOfWeek])
}

// ─────────────────────────────
// Patients
// ─────────────────────────────

model Patient {
  id             String   @id @default(cuid())
  hospitalNumber String   @unique
  firstName      String
  lastName       String
  otherNames     String?
  dateOfBirth    DateTime
  dobEstimated   Boolean  @default(false) // emergency: age was guessed
  sex            Sex
  phone          String
  email          String?
  address        String?

  nextOfKinName     String?
  nextOfKinPhone    String?
  nextOfKinRelation String?

  bloodGroup String?
  genotype   String?
  allergies  String?

  consentGiven Boolean   @default(false)
  consentAt    DateTime?

  isProvisional Boolean @default(false) // emergency record, details still to complete
  vitals        Vitals[]

  registeredById String
  registeredBy   User   @relation("PatientRegisteredBy", fields: [registeredById], references: [id])

  encounters   Encounter[]
  appointments Appointment[]

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([lastName, firstName])
  @@index([phone])
}

// ─────────────────────────────
// Appointments
// ─────────────────────────────

model Appointment {
  id           String            @id @default(cuid())
  scheduledAt  DateTime
  reason       String?
  visitType    VisitType         @default(NEW)
  status       AppointmentStatus @default(BOOKED)
  cancelReason String?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String
  doctor   User   @relation("AppointmentDoctor", fields: [doctorId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User   @relation("AppointmentCreatedBy", fields: [createdById], references: [id])

  encounterId String?    @unique
  encounter   Encounter? @relation(fields: [encounterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([scheduledAt])
}

// ─────────────────────────────
// Encounters (one visit)
// ─────────────────────────────

model Encounter {
  id             String          @id @default(cuid())
  type           EncounterType   @default(OUTPATIENT)
  status         EncounterStatus @default(WAITING)
  priority       Priority        @default(NORMAL)
  priorityReason String?
  visitType      VisitType       @default(NEW)
  reason         String?
  queueNumber    Int?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String?
  doctor   User?   @relation("EncounterDoctor", fields: [doctorId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User   @relation("EncounterCreatedBy", fields: [createdById], references: [id])

  appointment Appointment?
  vitals      Vitals[]

  // Stage timestamps — startedAt is check-in
  startedAt DateTime  @default(now())
  nurseAt   DateTime?
  doctorAt  DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId, status])
  @@index([departmentId])
  @@index([status])
}

// ─────────────────────────────
// Audit log
// ─────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// Atomic counters (yearly hospital numbers, daily queue numbers)
model Counter {
  key   String @id
  value Int    @default(0)
}

// Doctor leave / days off. Dates are "YYYY-MM-DD" in Lagos time, inclusive.
model DoctorLeave {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate   String
  endDate     String
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([doctorId, startDate, endDate])
}

// One set of vital signs. Every field is optional — record what was measured.
model Vitals {
  id              String   @id @default(cuid())
  encounterId     String
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id])
  recordedById    String
  recordedBy      User     @relation("VitalsRecordedBy", fields: [recordedById], references: [id])

  systolic        Int?     // mmHg
  diastolic       Int?     // mmHg
  temperature     Float?   // °C
  pulse           Int?     // beats per minute
  respiratoryRate Int?     // breaths per minute
  spo2            Int?     // %
  weightKg        Float?
  heightCm        Float?
  glucose         Float?   // random blood glucose, mmol/L
  notes           String?

  createdAt       DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([encounterId])
}
