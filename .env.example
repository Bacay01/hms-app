# Copy this file to .env and fill in the values. Never commit .env.

# Database (Neon Postgres)
DATABASE_URL=            # pooled connection, used by the app (end with sslmode=verify-full)
DATABASE_URL_UNPOOLED=   # direct connection, used by Prisma migrations (sslmode=require)

# Sessions — any long random string: openssl rand -hex 32
SESSION_SECRET=

# Public address of the app (used for payment callbacks)
APP_URL=http://localhost:3000

# Online payments: "simulated" (local testing, no account needed) or "paystack"
PAYMENT_GATEWAY=simulated
SIMULATED_GATEWAY_SECRET=   # openssl rand -hex 32
PAYSTACK_SECRET_KEY=        # sk_test_… from the Paystack dashboard (only when PAYMENT_GATEWAY=paystack)
